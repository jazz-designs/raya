# ==============================================================================
# SUPABASE CONFIGURATION
# ==============================================================================
# 1. Go to https://supabase.com and create or open your project.
# 2. Go to Project Settings -> API (or Project Settings -> Data API).
# 3. Copy "Project URL" into VITE_SUPABASE_URL.
# 4. Copy "anon" / "public" key into VITE_SUPABASE_ANON_KEY.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key

# Storage bucket where product images will be uploaded (Default: products)
VITE_SUPABASE_STORAGE_BUCKET=products

# Tables in Supabase (Leave as 'products' and 'categories' if using the provided SQL setup)
VITE_SUPABASE_PRODUCTS_TABLE=products
VITE_SUPABASE_CATEGORIES_TABLE=categories

# Optional Project / Database reference
VITE_SUPABASE_PROJECT_ID=your-project-id

# ==============================================================================
# OTHER SETTINGS
# ==============================================================================
GEMINI_API_KEY=""
APP_URL=""
